---
interface Props {
  class?: string;
}

const { class: className = "h-10 w-10" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width="64" height="64" rx="14" fill="#10211B" />
  <rect x="8" y="8" width="18" height="4" rx="2" fill="#D8FF3E" />
  <path d="M9 36H55" stroke="#D8FF3E" stroke-width="3" />
  <path d="M51 8H56V20" stroke="#BCE9F7" stroke-width="3" stroke-linecap="round" />
  <text
    x="8"
    y="31"
    fill="#F7F5ED"
    font-family="Arial, sans-serif"
    font-size="22"
    font-weight="900"
    letter-spacing="-1"
  >SE</text>
  <text
    x="26"
    y="56"
    fill="#F7F5ED"
    font-family="Arial, sans-serif"
    font-size="23"
    font-weight="900"
    letter-spacing="-1"
  >31</text>
</svg>
