---
import type { Course } from "../data/types";

interface Props {
  course: Course;
}

const { course } = Astro.props;
const base = import.meta.env.BASE_URL;

const department = course.code.split(" ")[0];
const accentClasses: Record<string, { badge: string; border: string }> = {
  MATH: {
    badge: "bg-sky text-ink",
    border: "border-t-sky",
  },
  CS: {
    badge: "bg-lime text-ink",
    border: "border-t-lime",
  },
  CHE: {
    badge: "bg-signal text-ink",
    border: "border-t-signal",
  },
  SE: {
    badge: "bg-spruce text-white dark:bg-[#7ed2ae] dark:text-ink",
    border: "border-t-spruce dark:border-t-[#7ed2ae]",
  },
};

const accent = accentClasses[department] ?? accentClasses.SE;
---

<article class={`brand-card flex h-full flex-col border-t-4 p-6 transition-transform duration-200 hover:-translate-y-1 motion-reduce:transform-none motion-reduce:transition-none ${accent.border}`}>
  <div class="flex items-start justify-between gap-4 mb-5">
    <span class={`inline-flex rounded-md px-3 py-1 font-mono text-xs font-black uppercase tracking-[0.08em] ${accent.badge}`}>
      {course.code}
    </span>
    <span class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.12em] text-muted dark:text-[#aebdb4]">
      1A / archived
    </span>
  </div>

  <h2 class="mb-3 text-2xl font-black tracking-[-0.025em] text-ink dark:text-paper">
    {course.title}
  </h2>
  <p class="mb-6 flex-grow leading-7 text-muted dark:text-[#b8c5be]">
    {course.summary}
  </p>

  <div class="flex flex-col sm:flex-row gap-3 mt-auto">
    <a
      href={`${base}courses/${course.slug}`}
      class="brand-button-primary text-sm"
    >
      Course guide
    </a>
    <a
      href={course.outlineUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="brand-button-secondary text-sm"
    >
      Archived outline ↗
    </a>
  </div>
</article>
