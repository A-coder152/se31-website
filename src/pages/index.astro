---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import BrandMark from "../components/BrandMark.astro";
import NowCard from "../components/NowCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { SITE_CONFIG } from "../data/siteConfig";
import { COURSES } from "../data/courses";
import { DEADLINES } from "../data/deadlines";
import { RESOURCES } from "../data/resources";
import { TIMETABLE, TIMETABLE_META } from "../data/timetable";
import {
  formatTorontoDate,
  formatTorontoDateTime,
  getDeadlineStartTime,
  getDeadlineStatus,
} from "../utils/date";

const base = import.meta.env.BASE_URL;
const now = new Date();

const currentDeadlines = DEADLINES
  .filter((deadline) => getDeadlineStatus(deadline, now) !== "past")
  .sort((a, b) => getDeadlineStartTime(a) - getDeadlineStartTime(b));

const nextMilestone = currentDeadlines.find((deadline) => deadline.deadlineType === "event");
const nextAction = currentDeadlines.find((deadline) => deadline.deadlineType === "action");
const verifiedDateCount = DEADLINES.filter((deadline) => deadline.verified).length;
const missingLocationCount = TIMETABLE.filter((event) => !event.location).length;

const shortcutDefinitions = [
  {
    sourceTitle: "Waterloo Ready Important Dates",
    title: "Waterloo Ready",
    description: "Incoming-student dates and next steps.",
  },
  {
    sourceTitle: "Undergraduate Important Dates",
    title: "Important Dates",
    description: "Fees, add/drop, Reading Week and exams.",
  },
  {
    sourceTitle: "Engineering First Year",
    title: "Engineering First Year",
    description: "Automatic enrolment and academic advising.",
  },
  {
    sourceTitle: "Current Students Hub",
    title: "Current Students",
    description: "Quest, LEARN, email, WatCard and The Centre.",
  },
];

const officialShortcuts = shortcutDefinitions.flatMap((definition) => {
  const resource = RESOURCES.find((item) => item.title === definition.sourceTitle);
  return resource ? [{ ...definition, url: resource.url }] : [];
});
---

<Layout
  title="SE31 Build Log — Waterloo Software Engineering 2031"
  description="A student-built home for Waterloo Software Engineering 2031: current dates, 1A course guides, an unofficial timetable, and trusted links."
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <section class="blueprint-grid relative overflow-hidden bg-ink px-4 py-14 text-paper sm:py-20 lg:py-24">
      <div class="pointer-events-none absolute -right-20 top-12 h-72 w-72 rounded-full border border-lime/20" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-4 top-28 h-44 w-44 rounded-full border border-sky/20" aria-hidden="true"></div>

      <div class="relative mx-auto grid max-w-7xl items-center gap-12 sm:px-2 lg:grid-cols-[1.25fr_0.75fr] lg:px-4">
        <div class="max-w-3xl">
          <p class="mb-5 font-mono text-xs font-black uppercase tracking-[0.19em] text-lime sm:text-sm">
            Waterloo Software Engineering · Class of 2031
          </p>
          <h1 class="max-w-3xl text-5xl font-black leading-[0.98] tracking-[-0.055em] sm:text-6xl lg:text-7xl">
            The working notebook for SE31.
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-[#d7e1db] sm:text-xl">
            One student-built place for the dates, courses, schedule and links we actually need—clear about what is official and what is still in progress.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#now" class="brand-button-highlight focus-visible:outline-lime">See what’s next <span aria-hidden="true">↓</span></a>
            <a href={`${base}courses`} class="brand-button-secondary border-paper text-paper hover:bg-white/10 focus-visible:outline-lime dark:text-paper">Explore 1A courses</a>
          </div>
          <p class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[0.68rem] font-bold uppercase tracking-[0.13em] text-[#b8c5be]">
            <span>Unofficial</span><span class="text-lime" aria-hidden="true">/</span>
            <span>Open source</span><span class="text-lime" aria-hidden="true">/</span>
            <span>Every date links to its source</span>
          </p>
        </div>

        <aside class="relative mx-auto w-full max-w-md" aria-label="Current site build status">
          <div class="absolute -left-3 -top-3 h-full w-full rounded-xl border border-lime/30" aria-hidden="true"></div>
          <div class="relative rounded-xl border border-[#43564c] bg-[#14211d] p-5 shadow-2xl sm:p-6">
            <div class="flex items-center justify-between gap-4 border-b border-[#43564c] pb-4">
              <div class="flex items-center gap-3">
                <BrandMark class="h-11 w-11" />
                <div>
                  <p class="font-mono text-[0.65rem] font-black uppercase tracking-[0.16em] text-lime">SE31 // current build</p>
                  <p class="mt-1 font-extrabold">1A foundation</p>
                </div>
              </div>
              <span class="h-2.5 w-2.5 rounded-full bg-lime shadow-[0_0_0_5px_rgb(216_255_62_/_0.12)]" aria-hidden="true"></span>
            </div>

            <dl class="mt-2 divide-y divide-[#34483e] text-sm">
              <div class="flex items-center justify-between gap-6 py-3.5">
                <dt class="font-mono text-xs uppercase tracking-wider text-[#aebdb4]">Course guides</dt>
                <dd class="font-bold text-paper">{COURSES.length} mapped</dd>
              </div>
              <div class="flex items-center justify-between gap-6 py-3.5">
                <dt class="font-mono text-xs uppercase tracking-wider text-[#aebdb4]">Verified dates</dt>
                <dd class="font-bold text-paper">{verifiedDateCount} checked</dd>
              </div>
              <div class="flex items-center justify-between gap-6 py-3.5">
                <dt class="font-mono text-xs uppercase tracking-wider text-[#aebdb4]">Timetable</dt>
                <dd class="rounded bg-signal px-2 py-1 font-mono text-[0.65rem] font-black uppercase tracking-wider text-ink">Unofficial draft</dd>
              </div>
              <div class="flex items-center justify-between gap-6 py-3.5">
                <dt class="font-mono text-xs uppercase tracking-wider text-[#aebdb4]">Timetable checked</dt>
                <dd class="font-bold text-paper">{formatTorontoDate(TIMETABLE_META.lastChecked)}</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </section>

    <section id="now" class="scroll-mt-24 px-4 py-14 sm:py-18 lg:py-20" aria-labelledby="now-heading">
      <div class="mx-auto max-w-7xl sm:px-2 lg:px-4">
        <SectionHeading
          id="now-heading"
          index="01"
          label="SE31 now"
          title="What matters next."
          description="What’s coming up, what needs action, and what is still uncertain."
        />
        <div class="mt-8 grid gap-5 lg:grid-cols-3">
          {nextMilestone ? (
            <NowCard
              label={getDeadlineStatus(nextMilestone, now) === "ongoing" ? "Happening now" : "Next milestone"}
              title={nextMilestone.title}
              href={nextMilestone.sourceUrl}
              linkLabel="Check the official source"
              tone="sky"
              external
            >
              <p class="font-bold text-ink dark:text-paper">{formatTorontoDateTime(nextMilestone.startDate)}</p>
              <p class="mt-2">{nextMilestone.description}</p>
              <p slot="meta" class="font-mono text-[0.67rem] font-bold uppercase tracking-[0.12em] text-muted dark:text-[#aebdb4]">
                Source checked {formatTorontoDate(nextMilestone.lastVerified)}
              </p>
            </NowCard>
          ) : (
            <NowCard
              label="Next milestone"
              title="Nothing upcoming is currently listed."
              href="https://uwaterloo.ca/important-dates/undergraduate"
              linkLabel="Check Waterloo’s dates"
              tone="sky"
              external
            >
              <p>Use Waterloo’s official undergraduate dates before making plans.</p>
            </NowCard>
          )}

          {nextAction ? (
            <NowCard
              label="Next action"
              title={nextAction.title}
              href={`${base}deadlines`}
              linkLabel="See all deadlines"
              tone="lime"
            >
              <p class="font-bold text-ink dark:text-paper">{formatTorontoDateTime(nextAction.startDate)}</p>
              <p class="mt-2">{nextAction.description}</p>
              <p slot="meta" class="font-mono text-[0.67rem] font-bold uppercase tracking-[0.12em] text-muted dark:text-[#aebdb4]">
                {nextAction.priority === "high" ? "High priority" : "Action required"} · Source checked {formatTorontoDate(nextAction.lastVerified)}
              </p>
            </NowCard>
          ) : (
            <NowCard label="Next action" title="Nothing currently needs action." href={`${base}deadlines`} linkLabel="Review all dates" tone="lime">
              <p>There is no action item in our current verified list.</p>
            </NowCard>
          )}

          <NowCard
            label="Timetable status"
            title={`${TIMETABLE_META.term} planning timetable`}
            href={`${base}timetable`}
            linkLabel="View the draft"
            tone="amber"
          >
            <p>{TIMETABLE_META.notice}</p>
            <p slot="meta" class="font-mono text-[0.67rem] font-bold uppercase tracking-[0.12em] text-muted dark:text-[#aebdb4]">
              {missingLocationCount} of {TIMETABLE.length} locations unconfirmed · Checked {formatTorontoDate(TIMETABLE_META.lastChecked)}
            </p>
          </NowCard>
        </div>
      </div>
    </section>

    <section class="paper-grid border-y border-[#d7ddd6] bg-[#eef1e9] px-4 py-14 dark:border-night-border dark:bg-[#0f1d19] sm:py-18 lg:py-20" aria-labelledby="courses-heading">
      <div class="mx-auto max-w-7xl sm:px-2 lg:px-4">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <SectionHeading
            id="courses-heading"
            index="02"
            label="1A / six courses"
            title="Meet the 1A stack."
            description="Six archived course guides, distilled into the topics, workload, grading, materials and policies you can scan quickly."
          />
          <p class="max-w-md rounded-lg border border-signal/70 bg-[#fff7d9] px-4 py-3 text-sm font-semibold leading-6 text-ink dark:bg-[#2a2412] dark:text-paper">
            Based on Fall 2025 outlines—not your Fall 2026 syllabus.
          </p>
        </div>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {COURSES.map((course, index) => (
            <a
              href={`${base}courses/${course.slug}`}
              class="brand-card group flex min-h-44 flex-col p-5 transition-transform duration-150 hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-spruce motion-reduce:transform-none motion-reduce:transition-none dark:focus-visible:outline-lime"
            >
              <div class="flex items-start justify-between gap-4">
                <span class="font-mono text-xs font-black uppercase tracking-[0.14em] text-spruce dark:text-lime">{course.code}</span>
                <span class="font-mono text-[0.62rem] font-bold uppercase tracking-[0.12em] text-muted dark:text-[#aebdb4]">{String(index + 1).padStart(2, "0")}</span>
              </div>
              <h3 class="mt-5 text-xl font-extrabold leading-tight tracking-[-0.025em] text-ink dark:text-paper">{course.title}</h3>
              <div class="mt-auto flex items-end justify-between gap-4 pt-6">
                <span class="text-xs font-semibold text-muted dark:text-[#aebdb4]">Fall 2025 outline</span>
                <span class="font-bold text-spruce transition-transform duration-150 group-hover:translate-x-1 motion-reduce:transform-none motion-reduce:transition-none dark:text-lime" aria-hidden="true">→</span>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-7">
          <a href={`${base}courses`} class="brand-button-primary">Explore all course guides</a>
        </div>
      </div>
    </section>

    {officialShortcuts.length > 0 && (
      <section class="px-4 py-14 sm:py-18 lg:py-20" aria-labelledby="resources-heading">
        <div class="mx-auto max-w-7xl sm:px-2 lg:px-4">
          <SectionHeading
            id="resources-heading"
            index="03"
            label="Official shortcuts"
            title="Keep these tabs close."
            description="Direct paths to the Waterloo pages behind the details."
          />
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {officialShortcuts.map((resource) => (
              <a
                href={resource.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-start justify-between gap-5 rounded-xl border border-[#c7d2c9] bg-panel p-5 transition-colors hover:border-spruce focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-spruce dark:border-night-border dark:bg-night-panel dark:hover:border-lime dark:focus-visible:outline-lime"
              >
                <div>
                  <p class="font-mono text-[0.65rem] font-black uppercase tracking-[0.14em] text-spruce dark:text-lime">Official Waterloo source</p>
                  <h3 class="mt-2 text-lg font-extrabold text-ink dark:text-paper">{resource.title}</h3>
                  <p class="mt-1 text-sm leading-6 text-muted dark:text-[#b8c5be]">{resource.description}</p>
                </div>
                <span class="mt-1 text-lg font-black text-spruce transition-transform duration-150 group-hover:translate-x-1 motion-reduce:transform-none motion-reduce:transition-none dark:text-lime" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>

          <div class="mt-7">
            <a href={`${base}resources`} class="brand-button-secondary">Browse all {RESOURCES.length} resources</a>
          </div>
        </div>
      </section>
    )}

    <section class="bg-spruce px-4 py-14 text-white sm:py-18 lg:py-20">
      <div class="mx-auto grid max-w-7xl gap-10 sm:px-2 lg:grid-cols-[1fr_auto] lg:items-center lg:px-4">
        <div class="max-w-3xl">
          <p class="font-mono text-xs font-black uppercase tracking-[0.18em] text-lime">04 / current build</p>
          <h2 class="mt-4 text-3xl font-black tracking-[-0.04em] sm:text-4xl">Useful now. Ours over time.</h2>
          <p class="mt-4 text-base leading-7 text-[#e2eee8] sm:text-lg">
            This build contains {COURSES.length} archived course guides, {verifiedDateCount} verified dates, {RESOURCES.length} curated resources, and one clearly labelled timetable draft. It gets better when SE31 students correct it, add to it, and make it their own.
          </p>
          <p class="mt-4 font-semibold text-white">Found an outdated date, a broken link, or a clearer way to explain a course?</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
          <a href={`${base}contribute`} class="brand-button-highlight focus-visible:outline-lime">Help build the log</a>
          <a href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener noreferrer" class="brand-button-secondary border-white text-white hover:bg-white/10 focus-visible:outline-lime dark:text-white">View the code ↗</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
